---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  initials: string;
  name: string;
  /** Portrait from the profile collection; the initials are rendered when it is missing. */
  photo?: ImageMetadata | undefined;
}

const { initials, name, photo } = Astro.props;
---

<div
  class="relative grid size-28 shrink-0 place-items-center rounded-full bg-primary font-heading text-4xl font-extrabold text-on-primary shadow-card ring-4 ring-surface sm:size-32"
>
  {
    photo ? (
      <Image
        src={photo}
        alt={`Foto de ${name}`}
        width={photo.width}
        height={photo.height}
        loading="eager"
        fetchpriority="high"
        class="size-full rounded-full object-cover object-top"
      />
    ) : (
      <span role="img" aria-label={`Avatar de ${name}`}>
        {initials}
      </span>
    )
  }
  <span
    aria-hidden="true"
    class="absolute -right-1 -bottom-1 size-7 rounded-full bg-accent ring-4 ring-surface"
  ></span>
</div>
