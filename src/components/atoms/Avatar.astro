---
interface Props {
  initials: string;
  name: string;
}

const { initials, name } = Astro.props;
---

<div
  role="img"
  aria-label={`Avatar de ${name}`}
  class="relative grid size-28 shrink-0 place-items-center rounded-full bg-primary font-heading text-4xl font-extrabold text-on-primary shadow-card ring-4 ring-surface sm:size-32"
>
  <span aria-hidden="true">{initials}</span>
  <span
    aria-hidden="true"
    class="absolute -right-1 -bottom-1 size-7 rounded-full bg-accent ring-4 ring-surface"
  ></span>
</div>
