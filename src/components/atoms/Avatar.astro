---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  initials: string;
  name: string;
  /** Portrait from the profile collection; the initials are rendered when it is missing. */
  photo?: ImageMetadata | undefined;
  class?: string;
}

const { initials, name, photo, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'relative shrink-0 rounded-full bg-ring-gradient p-1 shadow-glow-ember',
    className,
  ]}
>
  <div
    class="relative grid size-full place-items-center overflow-hidden rounded-full bg-surface font-display text-5xl font-bold text-primary"
  >
    {
      photo ? (
        <>
          <Image
            src={photo}
            alt={`Foto de ${name}`}
            width={photo.width}
            height={photo.height}
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover object-top contrast-110 saturate-[0.85]"
          />
          {/* Duotone-ish edge treatment: cold light from above, ember from below. */}
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-linear-to-b from-glow-cold/35 via-transparent to-glow-ember/30 mix-blend-soft-light"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 rounded-full shadow-[inset_0_0_40px_var(--color-bg)]"
          />
        </>
      ) : (
        <span role="img" aria-label={`Avatar de ${name}`}>
          {initials}
        </span>
      )
    }
  </div>
</div>
