---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: Variant;
}

const { href, variant = 'primary', class: className = '', ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-primary text-on-primary shadow-card hover:bg-primary-hover',
  secondary: 'border border-border bg-surface text-text hover:border-primary hover:text-primary',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-pill px-5 py-3 text-sm font-semibold transition-colors',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
