---
/** Inline stroke icon. Decorative by default (aria-hidden). */
import { iconPaths, type IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 20 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={iconPaths[name]}
/>
