---
import Icon from '../atoms/Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  href: string;
  label: string;
  value: string;
  icon: IconName;
  external?: boolean;
}

const { href, label, value, icon, external = false } = Astro.props;
---

<a
  href={href}
  class="group flex items-center gap-4 rounded-card border border-border bg-surface/70 p-5 shadow-card backdrop-blur-sm transition-[border-color,box-shadow] hover:border-primary/60 hover:shadow-glow-cold"
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <span
    class="grid size-11 shrink-0 place-items-center rounded-button bg-primary/10 text-primary ring-1 ring-primary/25 transition-colors group-hover:bg-ember group-hover:text-on-ember group-hover:ring-ember"
    aria-hidden="true"
  >
    <Icon name={icon} size={22} />
  </span>
  <span class="min-w-0">
    <span class="block text-sm text-muted">{label}</span>
    <span class="block truncate font-semibold text-text">{value}</span>
  </span>
</a>
