---
import Icon from '../atoms/Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  title: string;
  subtitle: string;
  year: number;
  icon: IconName;
  testId: string;
}

const { title, subtitle, year, icon, testId } = Astro.props;
---

<article
  data-testid={testId}
  class="flex h-full gap-4 rounded-card border border-border bg-surface p-6 shadow-card transition-colors hover:border-primary"
>
  <span
    class="grid size-11 shrink-0 place-items-center rounded-xl bg-primary/10 text-primary"
    aria-hidden="true"
  >
    <Icon name={icon} size={22} />
  </span>
  <div>
    <h3 class="font-bold text-text">{title}</h3>
    <p class="mt-1 text-sm text-muted">{subtitle}</p>
    <p class="mt-2 text-sm font-semibold text-accent">{year}</p>
  </div>
</article>
