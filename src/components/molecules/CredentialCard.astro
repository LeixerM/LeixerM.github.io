---
import Icon from '../atoms/Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  title: string;
  subtitle: string;
  year: number;
  icon: IconName;
  testId: string;
}

const { title, subtitle, year, icon, testId } = Astro.props;
---

<article
  data-testid={testId}
  class="flex h-full gap-4 rounded-card border border-border bg-surface/70 p-6 shadow-card backdrop-blur-sm transition-[border-color,box-shadow] hover:border-primary/60 hover:shadow-glow-cold"
>
  <span
    class="grid size-11 shrink-0 place-items-center rounded-button bg-primary/10 text-primary ring-1 ring-primary/25"
    aria-hidden="true"
  >
    <Icon name={icon} size={22} />
  </span>
  <div>
    <h3 class="text-lg leading-snug font-semibold tracking-wide text-text">{title}</h3>
    <p class="mt-1 text-sm text-muted">{subtitle}</p>
    <p class="mt-2 text-sm font-semibold text-accent">{year}</p>
  </div>
</article>
