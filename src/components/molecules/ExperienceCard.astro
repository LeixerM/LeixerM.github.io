---
import type { CollectionEntry } from 'astro:content';
import Tag from '../atoms/Tag.astro';
import { formatPeriod } from '../../lib/format';

interface Props {
  entry: CollectionEntry<'experience'>;
}

// `highlights` stay in the content files for the CV but the card shows only the summary.
const { company, role, project, start, end, summary, tech } = Astro.props.entry.data;
const isCurrent = end === null;
---

<article
  data-testid="experience-entry"
  class="relative rounded-card border border-border bg-surface/70 p-5 shadow-card backdrop-blur-sm transition-[border-color,box-shadow] hover:border-primary/60 hover:shadow-glow-cold sm:p-6"
>
  <span
    aria-hidden="true"
    class="absolute top-7 -left-[calc(1.5rem+7px)] hidden size-3.5 rounded-full bg-ember shadow-glow-ember ring-4 ring-bg sm:block md:-left-[calc(2.5rem+7px)]"
  ></span>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h3 class="text-lg font-semibold tracking-wide text-text uppercase sm:text-xl">{role}</h3>
      <p class="mt-1 text-sm">
        <span class="font-semibold text-primary">{company}</span>
        <span class="text-muted"> · {project}</span>
      </p>
    </div>
    <Tag tone={isCurrent ? 'primary' : 'neutral'}>
      <time datetime={start.toISOString().slice(0, 7)}>{formatPeriod(start, end)}</time>
    </Tag>
  </div>
  <p class="mt-3 text-text">{summary}</p>
  {
    tech.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tecnologías">
        {tech.map((item) => (
          <li>
            <Tag>{item}</Tag>
          </li>
        ))}
      </ul>
    )
  }
</article>
