---
import type { CollectionEntry } from 'astro:content';
import Icon from '../atoms/Icon.astro';
import Tag from '../atoms/Tag.astro';
import { formatPeriod } from '../../lib/format';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { company, role, project, start, end, highlights, tech } = Astro.props.entry.data;
const isCurrent = end === null;
---

<article
  data-testid="experience-entry"
  class="relative rounded-card border border-border bg-surface p-6 shadow-card sm:p-8"
>
  <span
    aria-hidden="true"
    class="absolute top-9 -left-[calc(1.5rem+7px)] hidden size-3.5 rounded-full bg-primary ring-4 ring-bg sm:block md:-left-[calc(2.5rem+7px)]"
  ></span>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h3 class="text-xl font-bold text-text">{role}</h3>
      <p class="mt-1 font-semibold text-primary">{company}</p>
      <p class="text-sm text-muted">{project}</p>
    </div>
    <Tag tone={isCurrent ? 'primary' : 'neutral'}>
      <time datetime={start.toISOString().slice(0, 7)}>{formatPeriod(start, end)}</time>
    </Tag>
  </div>
  <ul class="mt-5 space-y-2.5 text-text">
    {
      highlights.map((highlight) => (
        <li class="flex gap-3">
          <Icon name="check" size={18} class="mt-0.5 shrink-0 text-accent" />
          <span>{highlight}</span>
        </li>
      ))
    }
  </ul>
  {
    tech.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías">
        {tech.map((item) => (
          <li>
            <Tag>{item}</Tag>
          </li>
        ))}
      </ul>
    )
  }
</article>
