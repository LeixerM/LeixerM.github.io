---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="mb-12 max-w-2xl">
  <p class="mb-3 flex items-center gap-3 text-xs font-semibold tracking-eyebrow text-accent uppercase">
    <span aria-hidden="true" class="h-px w-10 bg-rule"></span>
    {eyebrow}
  </p>
  <h2 class="text-4xl leading-none font-bold text-text sm:text-6xl">{title}</h2>
  {lead && <p class="mt-4 text-lg text-muted">{lead}</p>}
</header>
