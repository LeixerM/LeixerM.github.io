---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="mb-10 max-w-2xl">
  <p class="mb-2 text-sm font-semibold tracking-widest text-accent uppercase">{eyebrow}</p>
  <h2 class="text-3xl font-extrabold tracking-tight text-text sm:text-4xl">{title}</h2>
  {lead && <p class="mt-3 text-lg text-muted">{lead}</p>}
</header>
