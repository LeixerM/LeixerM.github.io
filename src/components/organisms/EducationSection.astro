---
import { getCollection } from 'astro:content';
import SectionHeader from '../molecules/SectionHeader.astro';
import CredentialCard from '../molecules/CredentialCard.astro';
import { byOrder } from '../../lib/content';

const entries = (await getCollection('education')).sort(byOrder);
---

<section id="educacion" class="scroll-mt-24 border-y border-border bg-surface-alt bg-section-glow py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader eyebrow="Formación" title="Educación" />
    <ul class="grid gap-6 md:grid-cols-3">
      {
        entries.map((entry) => (
          <li>
            <CredentialCard
              testId="education-entry"
              icon="graduation"
              title={entry.data.degree}
              subtitle={entry.data.institution}
              year={entry.data.year}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
