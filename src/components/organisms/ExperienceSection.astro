---
import { getCollection } from 'astro:content';
import SectionHeader from '../molecules/SectionHeader.astro';
import ExperienceCard from '../molecules/ExperienceCard.astro';
import { byOrder } from '../../lib/content';

const entries = (await getCollection('experience')).sort(byOrder);
---

<section id="experiencia" class="scroll-mt-24 border-y border-border bg-surface-alt bg-section-glow py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader eyebrow="Trayectoria" title="Experiencia" />
    <ol class="space-y-8 sm:border-l sm:border-border-strong sm:pl-6 md:pl-10">
      {
        entries.map((entry) => (
          <li>
            <ExperienceCard entry={entry} />
          </li>
        ))
      }
    </ol>
  </div>
</section>
