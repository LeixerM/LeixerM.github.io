---
import { getCollection } from 'astro:content';
import Avatar from '../atoms/Avatar.astro';
import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';
import { cvPath } from '../../config/site';
import { getProfile } from '../../lib/content';
import { yearsSince } from '../../lib/format';

const profile = await getProfile();
const experience = await getCollection('experience');
const certifications = await getCollection('certifications');

const firstStart = new Date(Math.min(...experience.map((entry) => entry.data.start.getTime())));
const companies = new Set(experience.map((entry) => entry.data.company)).size;

const stats = [
  { value: `${yearsSince(firstStart)}+`, label: 'años de experiencia' },
  { value: String(companies), label: 'empresas' },
  { value: String(certifications.length), label: 'certificaciones' },
];
---

<section id="inicio" class="relative scroll-mt-24 overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 -right-32 size-[28rem] rounded-full bg-primary/15 blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-40 -left-24 size-[22rem] rounded-full bg-accent/10 blur-3xl"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28">
    <div class="flex flex-col gap-10 md:flex-row md:items-center md:gap-14">
      <Avatar initials={profile.initials} name={profile.displayName} />
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-widest text-accent uppercase">Hola, soy</p>
        <h1
          class="mt-2 text-4xl font-extrabold tracking-tight text-text sm:text-5xl lg:text-6xl"
        >
          {profile.displayName}
        </h1>
        <h2 class="mt-3 text-xl font-semibold text-primary sm:text-2xl">
          {profile.title} · {profile.role}
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-muted">{profile.summary}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#contacto">
            Contactar
            <Icon name="arrowRight" size={18} />
          </Button>
          <Button
            href={cvPath}
            variant="secondary"
            download="Leixer-Molina-CV.pdf"
            type="application/pdf"
          >
            <Icon name="download" size={18} />
            Descargar CV
          </Button>
        </div>

        <ul class="mt-6 flex gap-2" aria-label="Perfiles profesionales">
          <li>
            <a
              href={profile.contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="grid size-10 place-items-center rounded-pill text-muted transition-colors hover:bg-surface-alt hover:text-primary"
            >
              <Icon name="linkedin" />
            </a>
          </li>
          <li>
            <a
              href={profile.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="grid size-10 place-items-center rounded-pill text-muted transition-colors hover:bg-surface-alt hover:text-primary"
            >
              <Icon name="github" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <dl class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        stats.map((stat) => (
          <div class="flex flex-col rounded-card border border-border bg-surface/80 p-5 shadow-card backdrop-blur">
            <dt class="text-sm text-muted">{stat.label}</dt>
            <dd class="order-first font-heading text-3xl font-extrabold text-text">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
