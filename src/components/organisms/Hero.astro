---
import { getCollection } from 'astro:content';
import Avatar from '../atoms/Avatar.astro';
import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';
import { cvPath } from '../../config/site';
import { getProfile } from '../../lib/content';
import { yearsSince } from '../../lib/format';

const profile = await getProfile();
const experience = await getCollection('experience');
const certifications = await getCollection('certifications');

const firstStart = new Date(Math.min(...experience.map((entry) => entry.data.start.getTime())));
const companies = new Set(experience.map((entry) => entry.data.company)).size;

const stats = [
  { value: `${yearsSince(firstStart)}+`, label: 'años de experiencia' },
  { value: String(companies), label: 'empresas' },
  { value: String(certifications.length), label: 'certificaciones' },
];
---

<section
  id="inicio"
  class="relative isolate flex min-h-[calc(100svh-3.75rem)] scroll-mt-24 flex-col justify-center overflow-hidden bg-bg"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-atmosphere"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-grain"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-vignette"></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-px bg-linear-to-r from-transparent via-ember/60 to-transparent"
  >
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="flex flex-col gap-10 md:flex-row-reverse md:items-center md:justify-between md:gap-12">
      <Avatar
        initials={profile.initials}
        name={profile.displayName}
        photo={profile.photo}
        class="size-44 self-start sm:size-56 md:self-center lg:size-72"
      />
      <div class="min-w-0 max-w-3xl">
        <p class="flex items-center gap-3 text-xs font-semibold tracking-eyebrow text-accent uppercase">
          <span aria-hidden="true" class="h-px w-10 bg-rule"></span>
          Hola, soy
        </p>
        <h1
          class="mt-4 text-6xl leading-[0.9] font-bold text-text drop-shadow-[0_4px_24px_var(--color-bg)] sm:text-8xl lg:text-9xl"
        >
          {profile.displayName}
        </h1>
        <h2
          class="mt-5 font-display text-lg font-medium tracking-[0.18em] text-primary sm:text-2xl"
        >
          {profile.title} · {profile.role}
        </h2>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{profile.summary}</p>

        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="#contacto">
            Contactar
            <Icon name="arrowRight" size={18} />
          </Button>
          <Button
            href={cvPath}
            variant="secondary"
            download="Leixer-Molina-CV.pdf"
            type="application/pdf"
          >
            <Icon name="download" size={18} />
            Descargar CV
          </Button>
        </div>

        <ul class="mt-6 flex gap-2" aria-label="Perfiles profesionales">
          <li>
            <a
              href={profile.contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="grid size-10 place-items-center rounded-button text-muted transition-colors hover:bg-surface-alt hover:text-primary"
            >
              <Icon name="linkedin" />
            </a>
          </li>
          <li>
            <a
              href={profile.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="grid size-10 place-items-center rounded-button text-muted transition-colors hover:bg-surface-alt hover:text-primary"
            >
              <Icon name="github" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <dl class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        stats.map((stat) => (
          <div class="flex flex-col rounded-card border border-border bg-surface/50 p-5 shadow-card backdrop-blur-md">
            <dt class="font-display text-xs font-medium tracking-[0.2em] text-muted uppercase">{stat.label}</dt>
            <dd class="order-first font-display text-5xl font-bold text-text">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
