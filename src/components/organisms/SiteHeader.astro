---
import ThemeToggle from '../molecules/ThemeToggle.astro';
import { sections } from '../../config/site';

interface Props {
  brand: string;
}

const { brand } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/75 backdrop-blur-md">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 sm:px-6"
  >
    <a
      href="#inicio"
      class="font-display text-xl font-bold tracking-display text-text uppercase hover:text-primary"
    >
      {brand}<span class="text-accent">.</span>
    </a>
    <nav
      aria-label="Secciones"
      class="order-3 -mx-4 w-full overflow-x-auto px-4 md:order-none md:mx-0 md:ml-auto md:w-auto md:px-0"
    >
      <ul class="flex gap-1 font-display text-sm font-medium tracking-[0.12em] whitespace-nowrap uppercase">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class="block rounded-button px-3 py-2 text-muted transition-colors hover:bg-surface-alt hover:text-text"
              >
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto md:ml-0">
      <ThemeToggle />
    </div>
  </div>
</header>
