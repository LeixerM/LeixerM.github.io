---
import { getCollection } from 'astro:content';
import SectionHeader from '../molecules/SectionHeader.astro';
import SkillGroup from '../molecules/SkillGroup.astro';
import { byOrder, getProfile } from '../../lib/content';

const groups = (await getCollection('skills')).sort(byOrder);
const { languages } = await getProfile();
const languageItems = languages.map((language) => `${language.name} (${language.level})`);
---

<section id="habilidades" class="scroll-mt-24 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader eyebrow="Competencias" title="Habilidades" />
    <div class="grid gap-6 md:grid-cols-2">
      {
        groups.map((group, index) => (
          <SkillGroup
            label={group.data.label}
            items={group.data.items}
            tone={index === 0 ? 'primary' : 'neutral'}
          />
        ))
      }
      <SkillGroup label="Idiomas" items={languageItems} />
    </div>
  </div>
</section>
