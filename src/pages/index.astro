---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/organisms/Hero.astro';
import ExperienceSection from '../components/organisms/ExperienceSection.astro';
import ProjectsSection from '../components/organisms/ProjectsSection.astro';
import SkillsSection from '../components/organisms/SkillsSection.astro';
import EducationSection from '../components/organisms/EducationSection.astro';
import CertificationsSection from '../components/organisms/CertificationsSection.astro';
import ContactSection from '../components/organisms/ContactSection.astro';
import SiteFooter from '../components/organisms/SiteFooter.astro';
import { getProfile } from '../lib/content';

const { seo, displayName } = await getProfile();
---

<BaseLayout title={seo.title} description={seo.description} brand={displayName}>
  <Hero />
  <ExperienceSection />
  <ProjectsSection />
  <SkillsSection />
  <EducationSection />
  <CertificationsSection />
  <ContactSection />
  <SiteFooter slot="footer" />
</BaseLayout>
